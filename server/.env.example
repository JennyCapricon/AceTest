# Copy this file to .env and fill in your values.
# The .env file is gitignored and must never be committed.

# SQLite database file (relative to server/prisma)
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV=development

# Client URL (used to build password reset links)
CLIENT_URL="http://localhost:3000"

# SMTP (for password reset emails - optional in dev; reset links are logged to console when unset)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="AceTest <no-reply@acetest.com>"

# Cloudinary (for image/video uploads - optional)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Client (optional - defaults to http://localhost:5000/api)
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
