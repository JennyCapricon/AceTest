{
  "name": "acetest-server",
  "version": "1.0.0",
  "type": "module",
  "description": "AceTest Backend API",
  "main": "server.js",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prisma:generate": "npx prisma generate",
    "prisma:push": "npx prisma db push",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:generate:pg": "npx prisma generate --schema prisma/schema.postgres.prisma",
    "prisma:push:pg": "npx prisma db push --schema prisma/schema.postgres.prisma",
    "prisma:seed": "node prisma/seed.js",
    "create:admin": "node scripts/createAdmin.js",
    "flag:reset": "node scripts/flagPasswordReset.js"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.14.0",
    "uuid": "^9.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.3",
    "prisma": "^5.10.0"
  }
}
